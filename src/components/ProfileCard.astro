---
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === 'zh';
---

<aside class="profile-card">
  <p class="eyebrow">{isZh ? 'CHICAGO · 创作者' : 'CHICAGO · CREATOR'}</p>
  <div class="avatar">
    <img src="/images/avatar.jpg" alt="" width="96" height="96" />
  </div>
  <p class="greeting">{isZh ? '你好，我是宋二' : "Hi, I'm Yang"}</p>
  <p class="statement">
    {
      isZh
        ? '坐标芝加哥，在科技行业上班，业余做独立应用，用镜头记录生活，也挖掘一些有意思的故事。'
        : 'Based in Chicago, working in tech. I build indie apps on the side and use a camera to record everyday life — and to dig up the odd story worth telling.'
    }
  </p>
  <div class="tags">
    <span>{isZh ? '独立开发' : 'Indie dev'}</span>
    <span>{isZh ? '视频创作' : 'Video'}</span>
    <span>{isZh ? '北美生活' : 'Life in North America'}</span>
  </div>
  <div class="socials">
    <a href="https://www.rednote.com/user/profile/5ad21f596b58b74fe7a40a87">
      {isZh ? '小红书' : 'RedNote'}
    </a>
    <a href="https://www.youtube.com/@songer522">YouTube</a>
    <a href="https://m.weibo.cn/u/1174083720">{isZh ? '微博' : 'Weibo'}</a>
    <a href="mailto:songer522@gmail.com">{isZh ? '邮箱' : 'Email'}</a>
    <a href="https://github.com/songer522">GitHub</a>
  </div>
</aside>
