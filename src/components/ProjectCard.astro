---
interface Props {
  href: string;
  title: string;
  summary: string;
  status?: 'live' | 'wip' | 'free-tool';
  statusLabel?: string;
  cover?: string;
  /** App icon, shown inline before the title at the title's own size. */
  icon?: string;
  /**
   * An optional second destination — something you can do with the app right here,
   * rather than reading about it. The card itself still links to the detail page:
   * the title carries that link and stretches over the whole card, so this one sits
   * above it instead of nesting inside it, which HTML does not allow.
   */
  action?: { label: string; url: string };
  /**
   * True for a card in the first row of a grid that sits at the top of the page,
   * so its cover — the likely LCP image — loads eagerly. Every other card in the
   * grid defers until it is near the viewport.
   */
  eager?: boolean;
}

const {
  href,
  title,
  summary,
  status,
  statusLabel,
  cover,
  icon,
  action,
  eager = false,
} = Astro.props;
---

<article class="project-card">
  {status && statusLabel && <span class={`badge ${status}`}>{statusLabel}</span>}
  {
    cover && (
      <div class="cover">
        <img
          src={cover}
          alt=""
          width="1200"
          height="630"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </div>
    )
  }
  <div class="body">
    <p class="title">
      {icon && <img class="title-icon" src={icon} alt="" width="56" height="56" />}
      <a href={href}>{title}</a>
    </p>
    <p class="summary">{summary}</p>
    <div class="actions">
      {
        action && (
          <a class="play" href={action.url} target="_blank" rel="noopener noreferrer">
            {action.label}
          </a>
        )
      }
      <span class="cta" aria-hidden="true">→</span>
    </div>
  </div>
</article>
