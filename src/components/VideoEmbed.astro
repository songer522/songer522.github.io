---
import {
  pickPrimaryPlatform,
  otherPlatforms,
  platformUrl,
  platformLabel,
  embedUrl,
  type PlatformLink,
} from '../lib/video';
import { t, type Locale } from '../i18n/utils';

interface Props {
  platforms: PlatformLink[];
  locale: Locale;
  cover: string;
  title: string;
  playLabel: string;
}

const { platforms, locale, cover, title, playLabel } = Astro.props;
const tr = t(locale);

const primary = pickPrimaryPlatform(platforms, locale);
const others = otherPlatforms(platforms, primary);

// Whether this mirror can play inline also depends on the device, which a static
// build cannot know — the script below settles it at click time.
const playerUrl = embedUrl(primary);
const watchUrl = platformUrl(primary);

---

<div
  class="video-embed"
  data-embed-url={playerUrl}
  data-watch-url={watchUrl}
  data-platform={primary.platform}
  data-title={title}
>
  <img src={cover} alt="" width="1200" height="675" />
  <button type="button" class="play-button" aria-label={playLabel}>
    <span class="icon">▶</span>
  </button>
</div>

<p class="video-source">
  {tr('video.source')}: {platformLabel(primary.platform, locale)}
</p>

{
  others.length > 0 && (
    <p class="video-also-on">
      {tr('video.alsoOn')}:{' '}
      {others.map((p, i) => (
        <>
          {i > 0 && ' · '}
          <a href={platformUrl(p)}>{platformLabel(p.platform, locale)}</a>
        </>
      ))}
    </p>
  )
}

<script>
  import { canEmbedInline, type VideoPlatform } from '../lib/video';

  /**
   * Match what the platforms themselves gate on: bilibili's player.html turns these
   * user agents away, so this is the same signal, not a viewport guess. A narrow
   * desktop window is still a desktop.
   */
  const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);

  document.querySelectorAll<HTMLElement>('.video-embed').forEach((container) => {
    const button = container.querySelector('button.play-button');
    button?.addEventListener('click', () => {
      const url = container.dataset.embedUrl;
      const title = container.dataset.title ?? '';
      if (!url) return;

      const platform = container.dataset.platform as VideoPlatform | undefined;
      if (!platform || !canEmbedInline(platform, isMobile)) {
        // No player that works here, so send the reader somewhere that does.
        window.open(container.dataset.watchUrl ?? url, '_blank', 'noopener');
        return;
      }

      const iframe = document.createElement('iframe');
      iframe.src = url;
      iframe.title = title;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      container.innerHTML = '';
      container.appendChild(iframe);
    });
  });
</script>
