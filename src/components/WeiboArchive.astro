---
import WeiboCard from './WeiboCard.astro';
import WeiboHeatmap from './WeiboHeatmap.astro';
import { posts, stats, yearsWithPosts, countsByYear } from '../lib/weibo';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const summary = stats();
const years = yearsWithPosts();
const counts = countsByYear();

const counters = [
  { value: summary.posts.toLocaleString('en-US'), label: tr('weibo.stats.posts') },
  { value: summary.characters.toLocaleString('en-US'), label: tr('weibo.stats.characters') },
  { value: summary.images.toLocaleString('en-US'), label: tr('weibo.stats.images') },
  { value: `${summary.firstYear}—${summary.lastYear}`, label: tr('weibo.stats.years') },
];

/**
 * Switching a tab is one attribute change on the container — these rules do the rest.
 * Generating a rule per year keeps 1,223 cards untouched on every click, where a
 * JavaScript loop over them would be the slowest thing on the page.
 *
 * Only `.js` hides anything. With scripting off the page keeps its server-rendered
 * state: every post, under its year heading.
 */
const viewRules = years
  .map(
    (year) => `
.js .weibo-archive[data-view="${year}"] .weibo-card[data-year="${year}"] { display: block; }
.js .weibo-archive[data-view="${year}"] .weibo-heatmap[data-year="${year}"] { display: grid; }`,
  )
  .join('');
---

<section
  class="weibo-archive"
  data-view="all"
  data-total={summary.posts}
  data-year-counts={JSON.stringify(Object.fromEntries(counts))}
  data-label-today={tr('weibo.todayCount')}
  data-label-today-empty={tr('weibo.todayEmpty')}
  data-label-year={tr('weibo.yearCount')}
  data-label-all={tr('weibo.allCount')}
>
  <div class="weibo-stats">
    {
      counters.map((counter) => (
        <div>
          <strong>{counter.value}</strong>
          <span>{counter.label}</span>
        </div>
      ))
    }
  </div>

  <h2 class="weibo-heading">{tr('weibo.timeline')}</h2>

  <div class="weibo-tabs" role="tablist">
    <button type="button" role="tab" data-view="today" aria-selected="false">
      {tr('weibo.today')}
    </button>
    {
      years.map((year) => (
        <button type="button" role="tab" data-view={String(year)} aria-selected="false">
          {year} <span class="n">{counts.get(year)}</span>
        </button>
      ))
    }
    <button type="button" role="tab" data-view="all" aria-selected="true">
      {tr('weibo.all')} <span class="n">{summary.posts}</span>
    </button>
  </div>

  <div class="weibo-heatmaps">
    {years.map((year) => <WeiboHeatmap posts={posts} year={year} />)}
  </div>

  <p class="weibo-count" data-count>
    {tr('weibo.allCount').replace('{n}', String(summary.posts))}
  </p>

  <div class="weibo-list">
    {
      years.map((year) => (
        <>
          <h3 class="weibo-year" data-year={year}>
            {year}
          </h3>
          {posts
            .filter((post) => post.date.startsWith(String(year)))
            .map((post) => (
              <WeiboCard post={post} locale={locale} />
            ))}
        </>
      ))
    }
  </div>
</section>

<style set:html={viewRules}></style>

<script>
  /**
   * Tab switching, and the "on this day" default.
   *
   * `beijingMonthDay` and `pickRandom` come from the same modules the ingest script
   * uses, so the parts worth getting wrong — which day counts as today, and staying in
   * bounds when drawing at random — are the parts under test in `tests/`.
   *
   * The filtering itself is left to CSS. Cards carry `data-year` and `data-md`, the
   * container carries the active view, and WeiboArchive generates a rule per year. So
   * a tab click writes one attribute rather than walking 1,223 elements.
   */
  import { beijingMonthDay } from '../../scripts/lib/weibo-date.mjs';
  import { pickRandom } from '../../scripts/lib/weibo-on-this-day.mjs';
  import { cardElementId, cardIdFromHash } from '../../scripts/lib/weibo-anchor.mjs';

  const archive = document.querySelector<HTMLElement>('.weibo-archive');

  if (archive) {
    const label = archive.querySelector('[data-count]');
    const tabs = [...archive.querySelectorAll<HTMLButtonElement>('.weibo-tabs button')];
    const cards = [...archive.querySelectorAll<HTMLElement>('.weibo-card')];

    const total = archive.dataset.total ?? '0';
    const yearCounts: Record<string, number> = JSON.parse(archive.dataset.yearCounts ?? '{}');

    const monthDay = beijingMonthDay();
    let todays = cards.filter((card) => card.dataset.md === monthDay);

    // Nothing on this date in sixteen years of posting. Rather than show an empty
    // archive, turn up one post at random and say that is what happened.
    const drewRandom = todays.length === 0;
    if (drewRandom) {
      const one = pickRandom(cards);
      todays = one ? [one] : [];
    }

    for (const card of todays) card.classList.add('is-today');

    const show = (view: string) => {
      archive.dataset.view = view;
      for (const tab of tabs) tab.setAttribute('aria-selected', String(tab.dataset.view === view));

      if (!label) return;

      if (view === 'all') {
        label.textContent = (archive.dataset.labelAll ?? '').replace('{n}', total);
      } else if (view === 'today') {
        label.textContent = drewRandom
          ? (archive.dataset.labelTodayEmpty ?? '')
          : (archive.dataset.labelToday ?? '').replace('{n}', String(todays.length));
      } else {
        label.textContent = (archive.dataset.labelYear ?? '')
          .replace('{year}', view)
          .replace('{n}', String(yearCounts[view] ?? 0));
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => show(tab.dataset.view ?? 'all'));
    }

    /**
     * A link that names a post wins over the default view.
     *
     * Without this, `/weibo/#w-<id>` opens on 那年今日 and the filter hides the very
     * card the link pointed at — the reader lands on someone else's post, or on
     * nothing. The homepage strip hits this every time it falls back to a random post,
     * since it and the archive draw independently, and so does any shared or
     * bookmarked link to a single post.
     */
    const targeted = () => {
      const id = cardIdFromHash(location.hash);
      if (!id) return null;

      // The id comes off the URL, so escape it before it becomes a selector.
      return archive.querySelector<HTMLElement>(`#${CSS.escape(cardElementId(id))}`);
    };

    const reveal = (card: HTMLElement) => {
      show(card.dataset.year ?? 'all');
      // The browser already tried to jump here, while the card was still hidden.
      card.scrollIntoView();
    };

    const target = targeted();
    if (target) reveal(target);
    else show('today');

    // A fragment can also arrive after load, from a link elsewhere on the page.
    window.addEventListener('hashchange', () => {
      const card = targeted();
      if (card) reveal(card);
    });
  }
</script>
