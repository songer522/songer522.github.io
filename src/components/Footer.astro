---
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<footer class="site-footer">
  <div class="wrap">
    <span>{tr('footer.note')}</span>
    <a href="https://songer522.github.io/blog/">{tr('nav.blog')}</a>
  </div>
</footer>
