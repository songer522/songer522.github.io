---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { switchLocalePath, type Locale } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const zhPath = switchLocalePath(Astro.url.pathname, 'zh');
const enPath = switchLocalePath(Astro.url.pathname, 'en');
const zhUrl = new URL(zhPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="zh" href={zhUrl.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="x-default" href={zhUrl.href} />
    <link rel="icon" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <Nav locale={locale} />
    <main class="wrap">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
