---
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages serves a single 404.html for the whole domain, so this page
// cannot be locale-aware server-side — both languages are stacked, zh first,
// rather than attempting locale detection.
const locale = 'zh';
---

<BaseLayout title="页面未找到 · Page not found" description="页面未找到 · Page not found" locale={locale}>
  <div class="detail not-found">
    <h1 class="page-title">页面未找到</h1>
    <p>这个页面不存在，或者链接已经失效。</p>
    <p><a href="/">回到首页</a> · <a href="/apps/">查看作品</a></p>

    <hr />

    <h1 class="page-title">Page not found</h1>
    <p>This page doesn't exist, or the link is out of date.</p>
    <p><a href="/en/">Back home</a> · <a href="/en/apps/">Browse work</a></p>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
  }
  .not-found hr {
    margin: 2.5rem auto;
    max-width: 12rem;
    border: none;
    border-top: 1px solid var(--border);
  }
</style>
