---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import WeiboToday from '../components/WeiboToday.astro';
import { vlogs as allVlogs } from '../data/vlogs';
import { excludeCurated, formatVlogDate, youTubeIdsFrom } from '../lib/vlogs';
import { t, localeOf, slugOf } from '../i18n/utils';

const locale = 'zh';
const tr = t(locale);

/**
 * A line under each section heading. Written in Chinese and kept here rather than in
 * i18n/ui.ts because they only run on this page — the English homepage deliberately
 * has none, and inventing English versions nobody reads would be worse than not
 * having them. Same arrangement as about.astro, which carries its prose per locale.
 */
const notes = {
  apps: '用户增长曲线非常平稳。',
  videos: '把各种类型都涉猎了，还是没啥用。',
  weibo: '那时候我以为我很有意思。',
  blog: '那时候我以为我很有深度。',
  vlogs: '这个的主要受众可能只有 50 年后的大模型和大孙子。',
};

/** Labels the strip below it, now that the section heading carries the year range. */
const weiboTodayLabel = '那年今日';

// The same upload can sit in both the vlog playlist and the videos collection.
const vlogs = excludeCurated(allVlogs, youTubeIdsFrom(await getCollection('videos')));

const apps = (await getCollection('apps', ({ id }) => localeOf(id) === locale))
  .filter((a) => a.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const videos = (await getCollection('videos', ({ id }) => localeOf(id) === locale))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);
---

<BaseLayout title={tr('site.name')} description={tr('home.featured')} locale={locale}>
  <div class="home-layout">
    <ProfileCard locale={locale} />
    <div>
      <ProjectGrid title={tr('home.featured')} note={notes.apps}>
        {
          apps.map((app) => (
            <ProjectCard
              href={`/apps/${slugOf(app.id)}/`}
              title={app.data.title}
              summary={app.data.summary}
              status={app.data.status}
              statusLabel={tr(`status.${app.data.status}`)}
              cover={app.data.cover}
            />
          ))
        }
      </ProjectGrid>
      <a class="view-all" href="/apps/">{tr('card.viewAll')} →</a>

      <h2 class="section-title" style="margin-top: 3rem;">{tr('home.videos')}</h2>
      <p class="section-note">{notes.videos}</p>
      <div class="video-strip">
        {
          videos.map((video) => (
            <div>
              <VideoEmbed
                platforms={video.data.platforms}
                locale={locale}
                cover={video.data.cover}
                title={video.data.title}
                playLabel={tr('video.play')}
              />
              <p class="video-title">{video.data.title}</p>
            </div>
          ))
        }
      </div>
      <a class="view-all" href="/videos/">{tr('card.viewAll')} →</a>

      <h2 class="section-title" style="margin-top: 3rem;">{tr('home.weibo')}</h2>
      <p class="section-note">{notes.weibo}</p>
      <h3 class="weibo-heading">{weiboTodayLabel}</h3>
      <WeiboToday locale={locale} />
      <a class="view-all" href="/weibo/">{tr('card.viewAll')} →</a>

      <h2 class="section-title" style="margin-top: 3rem;">{tr('home.blog')}</h2>
      <p class="section-note">{notes.blog}</p>
      <a class="cta" href="https://songer522.github.io/blog/">{tr('home.blogCta')} →</a>

      <h2 class="section-title" style="margin-top: 3rem;">{tr('home.vlogs')}</h2>
      <p class="section-note">{notes.vlogs}</p>
      <div class="video-strip">
        {
          vlogs.slice(0, 3).map((vlog) => (
            <div>
              <VideoEmbed
                platforms={[{ platform: 'youtube', id: vlog.id }]}
                locale={locale}
                cover={`/images/vlogs/${vlog.id}.jpg`}
                title={vlog.title}
                playLabel={tr('video.play')}
              />
              <p class="video-title">{vlog.title}</p>
              {vlog.date && <p class="video-date">{formatVlogDate(vlog.date)}</p>}
            </div>
          ))
        }
      </div>
      <a class="view-all" href="/vlogs/">{tr('card.viewAll')} →</a>
    </div>
  </div>
</BaseLayout>
