---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, localeOf, slugOf } from '../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('apps', ({ id }) => localeOf(id) === 'zh');
  return entries.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const locale = 'zh';
const tr = t(locale);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} locale={locale}>
  <div class="detail">
    <a class="back" href="/apps/">← {tr('detail.back')}</a>
    <div class="cover">
      <img src={entry.data.cover} alt="" width="1200" height="630" />
    </div>
    <span class={`badge ${entry.data.status}`} style="position: static; display: inline-block; margin-bottom: 0.75rem;">
      {tr(`status.${entry.data.status}`)}
    </span>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
    {
      entry.data.tags.length > 0 && (
        <div class="tags">
          {entry.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      )
    }
    <Content />
    {
      entry.data.links.length > 0 && (
        <div class="links">
          <h2>{tr('detail.links')}</h2>
          <ul>
            {entry.data.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</BaseLayout>
