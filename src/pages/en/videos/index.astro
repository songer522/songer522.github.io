---
import { getCollection } from 'astro:content';
import VlogGrid from '../../../components/VlogGrid.astro';
import { vlogs as allVlogs } from '../../../data/vlogs';
import { excludeCurated, youTubeIdsFrom } from '../../../lib/vlogs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, localeOf, slugOf } from '../../../i18n/utils';

const locale = 'en';
const tr = t(locale);

// The same upload can sit in both the vlog playlist and the videos collection.
const vlogs = excludeCurated(allVlogs, youTubeIdsFrom(await getCollection('videos')));

const videos = (await getCollection('videos', ({ id }) => localeOf(id) === locale)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout title={tr('videos.title')} description={tr('videos.title')} locale={locale}>
  <h1 class="section-title" style="margin-top: 2rem;">{tr('home.videos')}</h1>
  <div class="project-grid">
    {
      videos.map((video) => (
        <a class="project-card" href={`/en/videos/${slugOf(video.id)}/`}>
          <div class="cover">
            <img src={video.data.cover} alt="" width="1200" height="630" />
          </div>
          <div class="body">
            <p class="title">{video.data.title}</p>
            <p class="summary">{video.data.summary}</p>
            <span class="cta">{tr('video.play')} →</span>
          </div>
        </a>
      ))
    }
  </div>

  <h2 class="section-title" style="margin-top: 3rem;">{tr('home.vlogs')}</h2>
  <p class="page-note">{tr('vlogs.note')}</p>
  <VlogGrid vlogs={vlogs.slice(0, 6)} />
  <a class="view-all" href="/en/vlogs/">{tr('vlogs.viewAll').replace('{n}', String(vlogs.length))} →</a>
</BaseLayout>
