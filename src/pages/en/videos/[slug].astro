---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { t, localeOf, slugOf } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('videos', ({ id }) => localeOf(id) === 'en');
  return entries.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;

const locale = 'en';
const tr = t(locale);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} locale={locale}>
  <div class="detail">
    <a class="back" href="/en/videos/">← {tr('detail.back')}</a>
    <VideoEmbed
      platform={entry.data.platform}
      videoId={entry.data.videoId}
      cover={entry.data.cover}
      title={entry.data.title}
      playLabel={tr('video.play')}
    />
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
  </div>
</BaseLayout>
