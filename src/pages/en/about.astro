---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/utils';

const locale = 'en';
const tr = t(locale);
---

<BaseLayout title={tr('about.title')} description={tr('about.title')} locale={locale}>
  <div class="detail">
    <h1 class="page-title">{tr('about.title')}</h1>
    <p>I live in Chicago and work in tech. I build indie apps on the side, and I make videos.</p>
    <p>
      The apps are small tools I wanted for myself; they&rsquo;re all on the work page. The videos are
      family trips, workdays in tech, camera comparisons, and the occasional research piece &mdash;
      posted to YouTube, RedNote and Bilibili.
    </p>
    <p>
      Before this I was a verified account on Weibo writing jokes, and before that, a blog.
    </p>
  </div>
</BaseLayout>
